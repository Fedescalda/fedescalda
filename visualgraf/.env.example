# ───── Sitio ─────
# URL pública (sin barra final). Se usa para SEO, sitemap y retorno de Mercado Pago.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp en formato internacional sin "+" ni espacios (54 9 + característica + número)
NEXT_PUBLIC_WHATSAPP=5493364622890
NEXT_PUBLIC_CONTACT_EMAIL=info@vgtubolsaimpresa.store
NEXT_PUBLIC_INSTAGRAM=visualgraf.tubolsaimpresa
NEXT_PUBLIC_FACEBOOK=visualgraf.tubolsaimpresa
NEXT_PUBLIC_CITY=

# ───── Supabase (opcional: sin esto la web usa datos de ejemplo) ─────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta: solo servidor. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ───── Mercado Pago (opcional: sin esto el pedido se cierra por WhatsApp) ─────
MP_ACCESS_TOKEN=
# Clave secreta de webhooks (Tus integraciones → Webhooks). Recomendado en producción.
MP_WEBHOOK_SECRET=

# ───── Avisos de pedidos y consultas (opcionales) ─────
# Email con Resend (resend.com, gratis). Sin dominio propio usá el remitente por defecto
# y poné en NOTIFY_EMAIL el mismo email con el que creaste la cuenta de Resend.
RESEND_API_KEY=
NOTIFY_EMAIL=
# NOTIFY_FROM=Visual Graf <avisos@vgtubolsaimpresa.store>   # solo con dominio verificado en Resend
# Celular con Telegram: token de @BotFather y tu chat id (ver README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
